# Use a stable python base
FROM ros:jazzy-ros-base

ARG LOCAL_UID=1000
ARG LOCAL_GID=1000

RUN apt update --fix-missing

# Install system dependencies needed to build the C++ extensions and common dev headers
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    sudo \
    build-essential \
    cmake \
    g++ \
    git \
    pkg-config \
    python3-venv \
    python3-dev \
    python3-colcon-common-extensions \
    python3-pip \
    python3-rosdep \
    libcap-dev \
    libpcap-dev \
    libzip-dev \
    libeigen3-dev \
    libflatbuffers-dev \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    freeglut3-dev \
    libx11-dev \
    libxrandr-dev \
    libxinerama-dev \
    libxcursor-dev \
    libxi-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /docker_ws/src/

# Use a single RUN layer to minimize image size
RUN rm -rf ouster-ros && \
    git clone -b ros2 --filter=blob:none --no-checkout https://github.com/errorcodecritical/ouster-ros && \
    cd ouster-ros && \
    git sparse-checkout set --cone ouster-sensor-msgs && \
    git checkout ros2 && \
    rosdep install --from-paths . -y --ignore-src

WORKDIR /docker_ws/

RUN . /opt/ros/$ROS_DISTRO/setup.sh && colcon build --packages-up-to ouster_sensor_msgs

# Create a minimal Python virtualenv for the app
WORKDIR /app
RUN python3 -m venv .venv
ENV PATH="/app/.venv/bin:$PATH"

# Copy entrypoint helper into the image
COPY ./docker_build/docker_entrypoint.py /app/docker_entrypoint.py
RUN chmod +x /app/docker_entrypoint.py

COPY ./docker_build/requirements.txt /app/requirements.txt

# Install pip tools first
RUN pip install --upgrade pip setuptools wheel
RUN pip install -r /app/requirements.txt

RUN set -eux; \
    existing_group="$(getent group ${LOCAL_GID} | cut -d: -f1 || true)"; \
    if [ -n "${existing_group}" ] && [ "${existing_group}" != "fruc-docker" ]; then \
        groupmod -n fruc-docker "${existing_group}"; \
    elif ! getent group fruc-docker >/dev/null 2>&1; then \
        groupadd -o --gid ${LOCAL_GID} fruc-docker; \
    fi; \
    existing_user="$(getent passwd ${LOCAL_UID} | cut -d: -f1 || true)"; \
    if [ -n "${existing_user}" ] && [ "${existing_user}" != "fruc-docker" ]; then \
        old_home="$(getent passwd "${existing_user}" | cut -d: -f6)"; \
        usermod -l fruc-docker -g ${LOCAL_GID} -s /bin/bash "${existing_user}"; \
        if [ -n "${old_home}" ] && [ "${old_home}" != "/home/fruc-docker" ] && [ -d "${old_home}" ]; then \
            usermod -d /home/fruc-docker -m fruc-docker; \
        else \
            usermod -d /home/fruc-docker fruc-docker; \
            mkdir -p /home/fruc-docker; \
        fi; \
    elif ! id -u fruc-docker >/dev/null 2>&1; then \
        useradd -o -m -u ${LOCAL_UID} -g ${LOCAL_GID} -s /bin/bash fruc-docker; \
    else \
        usermod -o --uid ${LOCAL_UID} --gid ${LOCAL_GID} --home /home/fruc-docker fruc-docker; \
        mkdir -p /home/fruc-docker; \
    fi; \
    chown -R ${LOCAL_UID}:${LOCAL_GID} /home/fruc-docker; \
    echo "fruc-docker ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/fruc-docker; \
    chmod 440 /etc/sudoers.d/fruc-docker

USER fruc-docker
ENV HOME=/home/fruc-docker

ENTRYPOINT ["python3", "/app/docker_entrypoint.py"]

# Default command: print help from the Python script.
CMD ["--help"]
