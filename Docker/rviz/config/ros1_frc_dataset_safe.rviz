Panels:
  - Class: rviz/Displays
    Name: Displays
    Help Height: 78
    Property Tree Widget:
      Expanded:
        - /Global Options
      Splitter Ratio: 0.5
      Tree Height: 560
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
  - Class: rviz/Views
    Name: Views

Visualization Manager:
  Class: "rviz::VisualizationManager"
  Enabled: true
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
    Hide/Show Disabled Controls: false
  Displays:
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Frame Timeout: 15
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Marker Scale: 1
      TF Prefix: /tf
    - Class: rviz/TF
      Enabled: false
      Name: TF Static
      Frame Timeout: 15
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Marker Scale: 1
      TF Prefix: /tf_static
    - Class: rviz/PointCloud2
      Enabled: false
      Name: Ouster Points
      Topic: /ouster/points
      Size (m): 0.02
      Style: Flat Squares
      Color Transformer: Intensity
      Min Color: 0
      Max Color: 255
      Alpha: 0.8
      Use Fixed Frame: true
      Position Transformer: XYZ
      Queue Size: 20
    - Class: rviz/Image
      Enabled: false
      Name: Color Image
      Topic: /camera/color/image_raw
      Transport Hint: raw
      Queue Size: 10
      Max Value: 255
      Min Value: 0
      Alpha: 1
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/MoveCamera
      Hide Inactive: false
  Value: true

Window Geometry:
  Displays:
    collapsed: false
