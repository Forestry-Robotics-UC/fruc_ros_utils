FROM ros:jazzy-ros-base

ARG ROSBAGS_INSTALL_SPEC=rosbags==0.10.11
ARG LOCAL_UID=1000
ARG LOCAL_GID=1000

############# System deps #########
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo \
    gosu \
        build-essential \
        cmake \
        git \
        libcap-dev \
        libpcap-dev \
        python3-pip \
        python3-dev \
        python3-usb \
        python3-colcon-common-extensions \
        python3-rosdep \
        ros-jazzy-rclpy \
        ros-jazzy-rosbag2-py \
        ros-jazzy-rosbag2-storage-mcap \
        ros-jazzy-rosbag2-storage-default-plugins \
        ros-jazzy-cv-bridge \
        ros-jazzy-sensor-msgs \
        ros-jazzy-diagnostic-msgs \
        ros-jazzy-tf2 \
        ros-jazzy-tf2-ros \
        ros-jazzy-tf2-sensor-msgs \
        ros-jazzy-image-geometry \
        ros-jazzy-image-transport \
        ros-jazzy-image-transport-plugins \
        ros-jazzy-librealsense2* \
        ros-jazzy-realsense2-* \
        python3-numpy \
        python3-opencv \
        python3-tqdm \
        python3-yaml \
        python3-pandas \
        python3-pyproj \
        python3-scipy \
        python3-matplotlib \
        python3-skimage \
        python3-argcomplete \
    && rm -rf /var/lib/apt/lists/*

############### Runtime user mapped to host uid/gid ################
RUN set -eux; \
    existing_group="$(getent group ${LOCAL_GID} | cut -d: -f1 || true)"; \
    if [ -n "${existing_group}" ] && [ "${existing_group}" != "fruc-docker" ]; then \
        groupmod -n fruc-docker "${existing_group}"; \
    elif ! getent group fruc-docker >/dev/null 2>&1; then \
        groupadd -o --gid ${LOCAL_GID} fruc-docker; \
    fi; \
    existing_user="$(getent passwd ${LOCAL_UID} | cut -d: -f1 || true)"; \
    if [ -n "${existing_user}" ] && [ "${existing_user}" != "fruc-docker" ]; then \
        old_home="$(getent passwd "${existing_user}" | cut -d: -f6)"; \
        usermod -l fruc-docker -g ${LOCAL_GID} -s /bin/bash "${existing_user}"; \
        if [ -n "${old_home}" ] && [ "${old_home}" != "/home/fruc-docker" ] && [ -d "${old_home}" ]; then \
            usermod -d /home/fruc-docker -m fruc-docker; \
        else \
            usermod -d /home/fruc-docker fruc-docker; \
            mkdir -p /home/fruc-docker; \
        fi; \
    elif ! id -u fruc-docker >/dev/null 2>&1; then \
        useradd -o --uid ${LOCAL_UID} --gid ${LOCAL_GID} --create-home --shell /bin/bash fruc-docker; \
    else \
        usermod -o --uid ${LOCAL_UID} --gid ${LOCAL_GID} --home /home/fruc-docker fruc-docker; \
        mkdir -p /home/fruc-docker; \
    fi; \
    chown -R ${LOCAL_UID}:${LOCAL_GID} /home/fruc-docker; \
    echo "fruc-docker ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/fruc-docker; \
    chmod 440 /etc/sudoers.d/fruc-docker

########### Build ROS message packages missing from the base image ###############
WORKDIR /opt/overlay_ws/src
RUN rm -rf ouster-ros && \
    git clone -b ros2 --filter=blob:none --no-checkout https://github.com/errorcodecritical/ouster-ros && \
    cd ouster-ros && \
    git sparse-checkout set --cone ouster-sensor-msgs && \
    git checkout ros2

WORKDIR /opt/overlay_ws
RUN . /opt/ros/jazzy/setup.sh && colcon build --packages-up-to ouster_sensor_msgs

# ── rosbags: default to a known-good version, allow override ─────────────────
RUN set -eu; \
    ROSBAGS_SPEC="${ROSBAGS_INSTALL_SPEC}"; \
    echo "Installing rosbags from ${ROSBAGS_SPEC}"; \
    pip3 install --break-system-packages "${ROSBAGS_SPEC}"

# ── Install fruc_ros_utils from pyproject.toml ───────────────────────────────
WORKDIR /workspace
COPY . .
RUN pip3 install --break-system-packages --no-deps --no-build-isolation .
RUN pip3 install --break-system-packages ouster_sdk==0.16.0
RUN pip3 install --break-system-packages "${ROSBAGS_INSTALL_SPEC}"

# ── Bake ROS2 + workspace sources into .bashrc ────────────────────────────────
RUN printf '\n# ── ROS 2 Jazzy ───────────────────────────────\n' >> /root/.bashrc \
    && echo 'source /opt/ros/jazzy/setup.bash'               >> /root/.bashrc \
    && echo 'source /opt/overlay_ws/install/setup.bash'      >> /root/.bashrc \
    && printf '# colcon workspace (mounted at runtime via compose)\n' >> /root/.bashrc \
    && echo '[[ -f /ws/install/setup.bash ]] && source /ws/install/setup.bash' >> /root/.bashrc \
    && cp /root/.bashrc /home/fruc-docker/.bashrc \
    && chown fruc-docker:fruc-docker /home/fruc-docker/.bashrc

USER fruc-docker
ENV HOME=/home/fruc-docker
WORKDIR /home/fruc-docker

CMD ["/bin/bash"]
