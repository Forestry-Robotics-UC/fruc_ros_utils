FROM ros:noetic-ros-base

ARG LOCAL_UID=1000
ARG LOCAL_GID=1000

# ── System deps ───────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo \
    gosu \
        python3-pip \
        python3-dev \
        python3-rosbag \
        ros-noetic-cv-bridge \
        ros-noetic-sensor-msgs \
        ros-noetic-image-geometry \
        ros-noetic-rospy \
        python3-numpy \
        python3-opencv \
        python3-tqdm \
        python3-yaml \
        python3-pandas \
        python3-pyproj \
        python3-scipy \
        python3-matplotlib \
        python3-skimage \
        python3-argcomplete \
    && rm -rf /var/lib/apt/lists/*

# ── Runtime user mapped to host uid/gid ─────────────────────────────────────
RUN set -eux; \
    existing_group="$(getent group ${LOCAL_GID} | cut -d: -f1 || true)"; \
    if [ -n "${existing_group}" ] && [ "${existing_group}" != "fruc-docker" ]; then \
        groupmod -n fruc-docker "${existing_group}"; \
    elif ! getent group fruc-docker >/dev/null 2>&1; then \
        groupadd -o --gid ${LOCAL_GID} fruc-docker; \
    fi; \
    existing_user="$(getent passwd ${LOCAL_UID} | cut -d: -f1 || true)"; \
    if [ -n "${existing_user}" ] && [ "${existing_user}" != "fruc-docker" ]; then \
        old_home="$(getent passwd "${existing_user}" | cut -d: -f6)"; \
        usermod -l fruc-docker -g ${LOCAL_GID} -s /bin/bash "${existing_user}"; \
        if [ -n "${old_home}" ] && [ "${old_home}" != "/home/fruc-docker" ] && [ -d "${old_home}" ]; then \
            usermod -d /home/fruc-docker -m fruc-docker; \
        else \
            usermod -d /home/fruc-docker fruc-docker; \
            mkdir -p /home/fruc-docker; \
        fi; \
    elif ! id -u fruc-docker >/dev/null 2>&1; then \
        useradd -o --uid ${LOCAL_UID} --gid ${LOCAL_GID} --create-home --shell /bin/bash fruc-docker; \
    else \
        usermod -o --uid ${LOCAL_UID} --gid ${LOCAL_GID} --home /home/fruc-docker fruc-docker; \
        mkdir -p /home/fruc-docker; \
    fi; \
    chown -R ${LOCAL_UID}:${LOCAL_GID} /home/fruc-docker; \
    echo "fruc-docker ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/fruc-docker; \
    chmod 440 /etc/sudoers.d/fruc-docker

# ── Install fruc_ros_utils from pyproject.toml ───────────────────────────────
WORKDIR /workspace
COPY . .
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel
RUN pip3 install --no-deps --no-build-isolation .

# ── Bake ROS1 + workspace sources into .bashrc ────────────────────────────────
# Every bash session (interactive shell, docker exec, etc.) gets them for free.
RUN printf '\n# ── ROS 1 Noetic ──────────────────────────────\n' >> /root/.bashrc \
    && echo 'source /opt/ros/noetic/setup.bash'              >> /root/.bashrc \
    && printf '# catkin workspace (mounted at runtime via compose)\n' >> /root/.bashrc \
    && echo '[[ -f /ws/devel/setup.bash ]] && source /ws/devel/setup.bash' >> /root/.bashrc \
    && cp /root/.bashrc /home/fruc-docker/.bashrc \
    && chown fruc-docker:fruc-docker /home/fruc-docker/.bashrc

USER fruc-docker
ENV HOME=/home/fruc-docker
WORKDIR /home/fruc-docker

CMD ["/bin/bash"]
